---
import "./Experience.css";

const experiences = [
  {
    role: "Director of AI & Engineering",
    company: "Idea Ranch",
    period: "2024 - Present",
  },
  {
    role: "Full-Stack Developer",
    company: "Idea Ranch",
    period: "2022 - 2024",
  },
  {
    role: "Independent Product Development",
    company: "Personal Projects",
    period: "2021 - Present",
  },
];
---

<div class="experience" data-animate>
  <span class="section-label">Experience</span>

  <div class="experience-list">
    {
      experiences.map((exp, index) => (
        <div
          class="exp-item"
          data-animate="left"
          data-animate-delay={`${0.06 + index * 0.05}s`}
        >
          <span class="exp-indicator">
            <span class="exp-dot" />
            {index < experiences.length - 1 && <span class="exp-line" />}
          </span>
          <span class="exp-period">{exp.period}</span>
          <div class="exp-details">
            <span class="exp-role">{exp.role}</span>
            <span class="exp-company">{exp.company}</span>
          </div>
        </div>
      ))
    }
  </div>
</div>
