---
import "./About.css";

const values = [
  { num: "01", text: "End-to-End Builds" },
  { num: "02", text: "Design in the Details" },
  { num: "03", text: "Modern Tooling" },
];
---

<div class="about" data-animate>
  <span class="section-label">About</span>

  <h2 class="about-headline" data-animate data-animate-delay="0.05s">
    I take products from first commit to production — across web, desktop, and
    mobile.
  </h2>

  <div class="about-body" data-animate="fade" data-animate-delay="0.1s">
    <p>
      Based in Tulsa, Oklahoma, I lead AI &amp; Engineering at Idea Ranch,
      where I build the digital side of the agency's client work — Shopify
      apps, headless storefronts, analytics platforms, and interactive kiosks
      for national brands.
    </p>
    <p>
      Outside client work, I ship my own products: a self-hosted QR platform,
      a font-syncing desktop app for design teams, and an AI-powered digital
      asset manager. I like owning the whole stack — architecture, interface,
      infrastructure — and sweating the details at every layer.
    </p>
  </div>

  <div class="about-values">
    {
      values.map((value, index) => (
        <div
          class="value"
          data-animate="left"
          data-animate-delay={`${0.14 + index * 0.05}s`}
        >
          <span class="value-num">{value.num}</span>
          <span class="value-text">{value.text}</span>
        </div>
      ))
    }
  </div>
</div>
