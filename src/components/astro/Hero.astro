---
import "./Hero.css";
---

<section id="intro" class="hero">
  <div class="hero-layout">
    <div class="hero-left">
      <div data-animate="fade">
        <span class="hero-label">
          <span class="label-dot" />
          Dakota Perry - Tulsa, OK
        </span>
      </div>

      <h1 class="hero-headline" data-animate data-animate-delay="0.05s">
        <span class="headline-line">I Build Products.</span>
        <span class="headline-line">Web to Desktop.</span>
      </h1>

      <p class="hero-description" data-animate data-animate-delay="0.1s">
        I'm Dakota Perry, Director of AI &amp; Engineering at Idea Ranch, a
        creative agency in Tulsa. I build software end to end — e-commerce
        platforms, analytics tools, desktop apps, and interactive kiosks — for
        brands like Cargill, Dometic, and Alberta Boot Co. Here's a selection
        of what I've shipped.
      </p>

      <div class="hero-cta" data-animate data-animate-delay="0.15s">
        <a href="#projects" data-hero-contact class="cta-secondary">
          <span>View my work</span>
          <span class="cta-arrow">→</span>
        </a>
      </div>
    </div>

  </div>

  <div class="hero-decoration" data-animate="fade" data-animate-delay="0.25s">
    <div class="decoration-line" />
  </div>
</section>

<script>
  const heroContact = document.querySelector("[data-hero-contact]");

  if (heroContact) {
    heroContact.addEventListener("click", (event) => {
      event.preventDefault();

      // import("../../openpanel")
      //   .then(({ op }) => {
      //     op.track("Hero CTA Click", {
      //       button: "Lets Talk",
      //       destination: "contact",
      //     });
      //   })
      //   .catch(() => {});

      const element = document.getElementById("projects");
      if (element) {
        element.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  }
</script>
