---
import "./Clients.css";

const clients = [
  { name: "Under Armour", logo: "UNDER ARMOUR" },
  { name: "Carhartt", logo: "CARHARTT" },
  { name: "Costa", logo: "COSTA" },
  { name: "Folds of Honor", logo: "FOLDS OF HONOR" },
  { name: "Cargill", logo: "CARGILL" },
  { name: "Toyota", logo: "TOYOTA" },
  { name: "Yamaha", logo: "YAMAHA" },
  { name: "Bushnell", logo: "BUSHNELL" },
];
---

<section class="clients">
  <div class="clients-container" data-animate>
    <div class="clients-header" data-animate="fade" data-animate-delay="0.05s">
      <span class="section-label">Trusted By</span>
      <p class="clients-subtext">
        Brands I've shipped work for, through Idea Ranch and beyond.
      </p>
    </div>

    <div class="clients-grid">
      {
        clients.map((client, index) => (
          <div
            class="client-logo"
            data-animate
            data-animate-delay={`${0.08 + index * 0.04}s`}
          >
            <span class="logo-text">{client.logo}</span>
            <span class="client-hover-bg" />
          </div>
        ))
      }
    </div>
  </div>
</section>
