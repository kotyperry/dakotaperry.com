---
import "./TechStack.css";

const stack: Record<string, string[]> = {
  Web: ["React", "Next.js", "Tailwind CSS", "Payload CMS"],
  "Mobile & Desktop": ["React Native", "Expo", "Tauri", "Rust"],
  "Data & Cloud": ["PostgreSQL", "Convex", "Supabase", "Cloudflare"],
  "Product Services": ["BigQuery", "Claude API", "Better Auth", "Trigger.dev"],
};
---

<div class="tech" data-animate>
  <span class="section-label">Preferred Stack</span>

  <div class="tech-grid">
    {
      Object.entries(stack).map(([category, items], groupIndex) => (
        <div class="tech-group" data-animate data-animate-delay={`${0.06 + groupIndex * 0.05}s`}>
          <h3 class="tech-category">{category}</h3>
          <ul class="tech-list">
            {
              items.map((item, itemIndex) => (
                <li data-animate="left" data-animate-delay={`${0.1 + groupIndex * 0.05 + itemIndex * 0.03}s`}>
                  <span class="tech-item-dot" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      ))
    }
  </div>
</div>
