---
import "./NotFound.css";
---

<div class="notfound-overlay">
  <div class="notfound-content">
    <div class="notfound-header" data-animate>
      <span class="notfound-label">
        <span class="label-dot" />
        Error 404
      </span>
      <h1 class="notfound-title">
        <span class="title-line">Page Not</span>
        <span class="title-line">Found</span>
      </h1>
      <p class="notfound-subtitle">
        The page you're looking for doesn't exist or has been moved.
      </p>
    </div>

    <div class="notfound-actions" data-animate data-animate-delay="0.1s">
      <a href="/" class="notfound-button">
        <span>Back to Home</span>
        <span class="button-arrow">→</span>
      </a>
    </div>

    <div class="notfound-footer" data-animate="fade" data-animate-delay="0.2s">
      <span class="footer-text">Dakota Perry - Portfolio</span>
    </div>
  </div>

  <div class="notfound-decoration">
    <div class="decoration-grid" />
  </div>
</div>
