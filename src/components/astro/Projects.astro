---
import "./Projects.css";
import { projects } from "../../data/projects";
---

<div class="projects" data-animate>
  <div class="projects-header" data-animate="fade" data-animate-delay="0.03s">
    <span class="section-label">Selected Work</span>
  </div>

  <div class="projects-grid">
    {
      projects.map((project, index) => (
        <a href={`/work/${project.id}`} style="text-decoration:none;color:inherit;">
          <article
            class="project-card"
            data-animate
            data-animate-delay={`${0.06 + index * 0.06}s`}
          >
            <div class="project-image" style={`background:${project.color}`}>
              <div class="project-placeholder">
                <span class="placeholder-num">{String(index + 1).padStart(2, "0")}</span>
                <span class="placeholder-text">View Project</span>
              </div>
              <div class="project-image-overlay" />
            </div>

            <div class="project-content">
              <div class="project-meta">
                <span class="project-category">{project.category}</span>
                <span class="project-year">{project.year}</span>
              </div>
              <h3 class="project-title">{project.title}</h3>
              <p class="project-description">{project.description}</p>
              <div class="project-tech">
                {
                  project.tech.slice(0, 3).map((tech, techIndex) => (
                    <span data-animate="left" data-animate-delay={`${0.12 + techIndex * 0.04}s`}>
                      {tech}
                    </span>
                  ))
                }
                {project.tech.length > 3 && (
                  <span class="tech-more">+{project.tech.length - 3}</span>
                )}
              </div>
            </div>

            <div class="project-card-cta">
              <span>View Case Study</span>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </div>

            <div class="project-card-glow" />
          </article>
        </a>
      ))
    }
  </div>
</div>
